---
import MetaPage from "@/components/MetaPage.astro";
import { SOCIALS } from "@/consts";
import Layout from "@/layouts/Layout.astro";

const posts = [
	{
		title: "xmenu - dmenu without x11",
		date: "2026 · 09",
		href: "/blog/xmenu-dmenu-without-x11",
	},
];
---

<Layout home>
	<MetaPage slot="head" />
	<main class="home-content">
		<p class="bio">
			Hi! I'm Gaurav Vashisth (aka r2adio), a software engineer based in Delhi.
			I write about things I'm interested in, mostly ML/AI, backend systems, and
			DevOps. You can reach me at
			<a href="mailto:gauravvashisth365@gmail.com"
				>gauravvashisth365@gmail.com</a
			>.
		</p>

		<div class="post-list">
			{posts.map((post) => (
				<div class="post-item">
					<span class="post-title">
						<a href={post.href}>{post.title}</a>
					</span>
					<span class="post-date">{post.date}</span>
				</div>
			))}
		</div>
	</main>

	<page-footer slot="home-footer" class="home-footer">
		{SOCIALS.map((link) => (
			<a href={link.href} target={link.href.startsWith("http") ? "_blank" : undefined} rel={link.href.startsWith("http") ? "noopener noreferrer" : undefined}>
				{link.label}
			</a>
		))}
	</page-footer>
</Layout>

<style>
	.home-content {
		display: flex;
		flex-direction: column;
		gap: var(--space-xl);
	}

	.bio {
		font-size: var(--step-0);
		line-height: calc(var(--leading-offset) + 1em);
		color: var(--prose-foreground);

		a {
			color: var(--link);
			text-decoration: underline;
			text-decoration-color: var(--link);
			text-decoration-thickness: max(1px, 0.0625em);
			text-underline-offset: -0.06em;

			&:hover {
				color: var(--foreground);
				text-decoration-color: var(--foreground);
			}
		}
	}

	.projects, .posts {
		display: flex;
		flex-direction: column;
		gap: var(--space-s);
	}

	h2 {
		font-size: var(--step-0);
		font-weight: var(--font-weight-medium);
		color: var(--foreground);
	}

	.project-list, .post-list {
		display: flex;
		flex-direction: column;
		gap: var(--space-s);
	}

	.project-item, .post-item {
		display: flex;
		flex-direction: column;
		gap: var(--space-3xs);
	}

	.project-item a, .post-title a {
		font-size: var(--step-0);
		line-height: calc(var(--leading-offset) + 1em);
		color: var(--link);
		text-decoration: underline;
		text-decoration-color: var(--link);
		text-decoration-thickness: max(1px, 0.0625em);
		text-underline-offset: -0.06em;

		&:hover {
			color: var(--foreground);
			text-decoration-color: var(--foreground);
		}
	}

	.project-desc, .post-date {
		font-family: var(--font-mono);
		font-size: var(--step--1);
		color: var(--muted-foreground);
		white-space: nowrap;
	}

	.post-date {
		font-family: var(--font-mono);
	}

	.home-footer {
		display: flex;
		align-items: center;
		gap: var(--space-s);
		padding-block: var(--space-m) 0;

		a {
			font-size: var(--step--1);
			color: var(--muted-foreground);
			text-decoration: underline;
			text-decoration-color: var(--muted-foreground);

			&:hover {
				color: var(--foreground);
				text-decoration-color: currentColor;
			}
		}
	}
</style>
