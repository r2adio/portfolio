---
import MetaPage from "@/components/MetaPage.astro";
import ThemeToggle from "@/components/ThemeToggle.astro";
import Layout from "@/layouts/Layout.astro";
---

<Layout>
	<MetaPage slot="head" />
	<dictionary-entry>
		<h1><span>Gaurav Vashisth</span><ThemeToggle /></h1>
		<!-- TODO: links to blogs projects authors, replacement of table of content on left -->
		<hr> <!-- divider  -->
		<prose-content>
			<p>
				I'm Gaurav (aka r2adio), and this is my personal blog. I'm a software
				engineer working on backend services and AI. I'm interested in career
				development, communications, and developer toolings.
			</p>
			<p>
				<!-- TODO: list of my blogs -->
			</p>
		</prose-content>
	</dictionary-entry>
</Layout>

<style>
	dictionary-entry {
		display: block;
		font-size: var(--step-0);
		color: var(--muted-foreground);

		@media (width >= 64rem) {
			margin-block-start: -0.2em;
		}

		ipa-span {
			opacity: 0.6;
		}

		h1 {
			display: flex;
			align-items: center;
			justify-content: space-between;
			font-size: var(--step-2);
			line-height: calc(var(--leading-offset) + 1em);
			font-weight: var(--font-weight-medium);
			color: var(--foreground);
			margin-block-end: var(--space-2xs);
		}

		ol {
			margin-block-start: var(--space-xs);
			list-style: none;

			li {
				padding-inline-start: 1em;
				text-indent: -1em;

				&::before {
					content: counter(list-item);
					display: inline-block;
					inline-size: 1em;
					text-indent: 0;
					font-weight: var(--font-weight-medium);
				}

				+ li {
					margin-block-start: var(--space-3xs);
				}
			}
		}

		hr {
			margin-block: var(--space-m);
			border-block-start: 2px solid var(--border);
		}

		prose-content {
			margin-block-start: var(--space-xs);
		}
	}
</style>
