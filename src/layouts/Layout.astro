---
import "@/styles/reset.css";
import "@/styles/fonts.css";
import "@/styles/color.css";
import "@/styles/typography.css";
import "@/styles/typography-headings.css";
import "@/styles/typography-inline.css";
import "@/styles/typography-lists.css";
import "@/styles/typography-block.css";
import "@/styles/typography-tables.css";
import "@/styles/typography-math.css";
import "@/styles/callout.css";
import "@/styles/layout.css";
import "@/styles/icon-button.css";
import "@/styles/bar.css";
import "@/styles/shape.css";

import Footer from "@/components/Footer.astro";
import MetaHead from "@/components/MetaHead.astro";
import ThemeToggle from "@/components/ThemeToggle.astro";
import { SITE } from "@/consts";

type Props = { crumbs?: { label: string; href: string }[]; home?: boolean };

const { home = false } = Astro.props;
---

<html lang={SITE.locale} dir={SITE.dir}>
	<MetaHead>
		<slot name="head" />
	</MetaHead>
	<script is:inline>
		(() => {
			const root = document.documentElement;
			const theme = localStorage.getItem("theme");
			if (theme) {
				root.dataset.theme = theme;
			} else if (matchMedia("(prefers-color-scheme: dark)").matches) {
				root.dataset.theme = "dark";
			}
		})();
	</script>
	<body>
		<page-grid>
			<page-header>
				<nav>
					<a href="/" class="site-name">{SITE.title}</a>
					<div class="nav-right">
						<ThemeToggle />
						{!home && <slot name="actions" />}
					</div>
				</nav>
			</page-header>
			<page-content>
				{Astro.slots.has("toc") && <page-toc><slot name="toc" /></page-toc>}
				<main><slot /></main>
				{home && <slot name="home-footer" />}
				{!home && <page-footer><Footer /></page-footer>}
			</page-content>
		</page-grid>
	</body>
</html>

<style>
	page-grid {
		display: flex;
		flex-direction: column;
		max-width: var(--measure);
		min-height: 100svh;
		margin-inline: auto;
		padding-inline: var(--grid-gutter);
		padding-block: 0 var(--space-l);
		color: var(--foreground);
		background-color: var(--background);
	}

	page-header {
		position: sticky;
		top: 0;
		z-index: 20;
		margin-inline: calc(-1 * var(--grid-gutter));
		padding-block: var(--space-s);
		padding-inline: var(--grid-gutter);
		margin-block-end: var(--space-xl);
		background-color: var(--background);
		border-block-end: 1px solid var(--border);
	}

	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
	}

	.site-name {
		font-weight: var(--font-weight-medium);
		text-decoration: none;
		color: var(--foreground);

		&:hover {
			text-decoration: none;
		}
	}

	.nav-right {
		display: flex;
		align-items: center;
		gap: var(--space-2xs);
	}

	page-content {
		display: flex;
		flex-direction: column;
		flex: 1;
		min-width: 0;

		main {
			flex: 1;
		}

		page-footer {
			display: block;
			margin-block-start: var(--space-xl);
		}
	}

	page-toc {
		display: block;
		margin-block-end: var(--space-s);
	}
</style>
