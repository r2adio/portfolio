---
import "@/styles/reset.css";
import "@/styles/fonts.css";
import "@/styles/color.css";
import "@/styles/typography.css";
import "@/styles/typography-headings.css";
import "@/styles/typography-inline.css";
import "@/styles/typography-lists.css";
import "@/styles/typography-block.css";
import "@/styles/typography-tables.css";
import "@/styles/typography-math.css";
import "@/styles/callout.css";
import "@/styles/layout.css";
import "@/styles/icon-button.css";
import "@/styles/bar.css";
import "@/styles/shape.css";

import Footer from "@/components/Footer.astro";
import MetaHead from "@/components/MetaHead.astro";
import Sidebar from "@/components/Sidebar.astro";
import { SITE } from "@/consts";

type Props = { crumbs?: { label: string; href: string }[]; home?: boolean };

const { crumbs, home = false } = Astro.props;
---

<html lang={SITE.locale} dir={SITE.dir}>
	<MetaHead>
		<slot name="head" />
	</MetaHead>
	<script is:inline>
		(() => {
			const root = document.documentElement;
			const theme = localStorage.getItem("theme");
			if (theme) {
				root.dataset.theme = theme;
			} else if (matchMedia("(prefers-color-scheme: dark)").matches) {
				root.dataset.theme = "dark";
			}
		})();
	</script>
	<body>
		<page-grid data-home={home || undefined}>
			{!home && (
			<page-header>
				<page-nav>
					<Sidebar crumbs={crumbs}
						><slot name="actions" slot="actions" /></Sidebar
					>
				</page-nav>
				{Astro.slots.has("toc") && (
            <page-toc><slot name="toc" /></page-toc>
          )}
			</page-header>
			)}
			<page-content>
				<main><slot /></main>
				{home && <slot name="home-footer" />}
				{!home && <page-footer><Footer /></page-footer>}
			</page-content>
		</page-grid>
	</body>
</html>

<style>
	page-grid {
		position: relative;
		isolation: isolate;
		display: grid;
		grid-template-columns: repeat(var(--grid-columns), minmax(0, 1fr));
		gap: var(--grid-gutter);
		max-width: var(--grid-max-width);
		min-height: 100svh;
		margin-inline: auto;
		padding-inline: var(--grid-gutter);
		padding-block: var(--page-offset-top);

		@media (width < 64rem) {
			grid-template-columns: 1fr;
			grid-template-rows: auto 1fr;
			padding-block: 0;
		}
	}

	page-header {
		display: contents;

		@media (width < 64rem) {
			display: block;
			grid-column: 1 / -1;
			position: sticky;
			top: 0;
			z-index: 10;
			min-width: 0;
			margin-inline: calc(-1 * var(--grid-gutter));
		}
	}

	page-nav {
		display: block;
		min-width: 0;
		grid-column: 10 / 13;
		grid-row: 1;

		@media screen and (width >= 64rem) {
			position: fixed;
			inset-block: var(--page-offset-top) var(--page-offset-bottom);
			inset-inline-end: var(--grid-edge);
			width: calc(3 * var(--grid-column-width) + 2 * var(--grid-gutter));
		}
	}

	page-toc {
		display: block;
		min-width: 0;
		grid-column: 1 / 3;
		grid-row: 1;

		@media screen and (width >= 64rem) {
			position: fixed;
			inset-block: var(--page-offset-top) var(--page-offset-bottom);
			inset-inline-start: var(--grid-edge);
			width: calc(2 * var(--grid-column-width) + var(--grid-gutter));
		}
	}

	page-content {
		display: flex;
		flex-direction: column;
		grid-column: 3 / 10;
		grid-row: 1;
		min-width: 0;

		main {
			flex: 1;
		}

		page-footer {
			display: block;
			margin-block-start: var(--space-xl);
		}

		@media (width < 64rem) {
			grid-column: 1 / -1;
			grid-row: auto;
			inline-size: 100%;
			max-inline-size: var(--measure);
			margin-inline: auto;
		}
	}

	page-grid[data-home] {
		grid-template-columns: 1fr;
		max-width: var(--measure);
		padding-block: var(--space-l);
		display: flex;
		flex-direction: column;
		min-height: 100svh;
		color: var(--foreground);
		background-color: var(--background);

		@media (width < 64rem) {
			padding-block: 0;
		}
	}

	page-grid[data-home] page-content {
		flex: 1;
		display: flex;
		flex-direction: column;
		max-inline-size: 100%;
	}
</style>
